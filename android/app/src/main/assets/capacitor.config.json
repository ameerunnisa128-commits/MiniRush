{
	"appId": "com.minirush.arcade",
	"appName": "MiniRush",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"backgroundColor": "#020617",
		"allowMixedContent": false,
		"captureInput": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1800,
			"launchAutoHide": true,
			"backgroundColor": "#020617",
			"showSpinner": false
		}
	}
}
